{
  "name": "dsh-plugin-marketplace",
  "version": "0.3.1",
  "description": "实时同步 GitHub dsh-plugin topic 的插件市场：Host 定时抓取并缓存，Web 设置页展示可搜索的插件列表，并支持已装插件的更新 / 关闭 / 卸载与市场自更新检查。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/AwesomeHou/dsh-plugin-marketplace.git"
  },
  "homepage": "https://github.com/AwesomeHou/dsh-plugin-marketplace",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "build": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin-marketplace",
    "deepseek-harness"
  ],
  "license": "MIT"
}
